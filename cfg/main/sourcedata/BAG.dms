container BAG
{
	container Snapshot
	: Descr = "BAG op een peildatum: per object het voorkomen dat op Parameters/BAG_Date geldig is, alle statussen."
	, Source = "Gegenereerd met BAG-Tools, cfg/MakeSnapshot.dms, /snapshots/nl_status_all_with_strangevalues_no_heigth_mmd"
	{
		parameter<String>  BAG_dir                  := '%BAG_DIR%/BAG_' + Parameters/BAG_FileDate + '_Snapshot_' + Parameters/BAG_Date;
		parameter<String>  Bouwjaar_truncation_Expr := 'Bouwjaar <= 1005w || Bouwjaar > @YYYY@[yr] ? null_w : Bouwjaar < 1500w ? 1500w : Bouwjaar';
		parameter<String>  max_Bouwjaar             := string(Parameters/BAG_RecentYear);

		container store
		:	StorageName     = "= BAG_dir + '/bag.mmd'"
		,	StorageReadOnly = "True"
		{
		}

		// de koppeling loopt over de labeltekst en niet over de volgorde van de codes
		attribute<pand_status> pand_status_rel (store/status_pand) := rlookup(LowerCase(store/status_pand/Label), LowerCase(pand_status/Label));

		container panden
		{
			unit<UInt32> src := store/pand
			{
				attribute<rdc_meter>                    geometry_org (poly)          := store/pand/geometry[rdc_meter];
				attribute<uint64>                       pand_bag_nr                  := store/pand/identificatie;
				attribute<pand_status>                  status_rel                   := pand_status_rel[store/pand/meta/status_rel];
				attribute<yr>                           Bouwjaar                     := value(store/pand/bouwjaar, yr);
				attribute<yr>                           Bouwjaar_trunc               := =replace(Bouwjaar_truncation_Expr, '@YYYY@', max_Bouwjaar);
				attribute<m2>                           Footprint                    := area(geometry, m2);
				attribute<Bool>                         IsVoorraad                   := pand_status/isVoorraad[status_rel];
				attribute<rdc_meter>                    geometry (poly)              := recollect_by_cond(Impl/HasNegativearea, Impl/select_reversed_winding_order/geometry_reversed, geometry_org);

				// attribute<bool> IsStudyArea := IsNoord_Holland; // const(TRUE, .);
				attribute<bool> IsStudyArea := const(TRUE, .);

				unit<UInt32> Impl := .
				{
					//script to flip negative winding orders
					attribute<Bool>                     HasNegativearea              := area(geometry_org, m2) < 0[m2];
					unit<UInt32> select_reversed_winding_order := select_with_org_rel(HasNegativearea)
					{
						attribute<rdc_meter>                geometry (poly)          := src/geometry_org[org_rel];

						unit<UInt32> seq_points := sequence2points(geometry)
						{
							attribute<rdc_meter> points_reversed       := reverse(point);
							attribute<UInt32>    Sequence_rel_Reversed := reverse(Sequence_rel);
						}

						attribute<m2>        area_reversed            := area(geometry_reversed, m2);
						attribute<rdc_meter> geometry_reversed (poly) := points2polygon(seq_points/points_reversed, seq_points/Sequence_rel_Reversed);
					}

					attribute<rdc_meter>                    NW                           := lower_bound(geometry);
					attribute<rdc_meter>                    SE                           := upper_bound(geometry);
					attribute<Float64>                      X_ext                        := sub_or_null(PointCol(SE),PointCol(NW));
					attribute<Float64>                      Y_ext                        := sub_or_null(PointRow(SE),PointRow(NW));

					attribute<Float64>                      lower_x := PointCol(NW);
					attribute<Float64>                      upper_x := PointCol(SE);
					attribute<Float64>                      lower_y := PointRow(NW);
					attribute<Float64>                      upper_y := PointRow(SE);

					attribute<Bool>                         pand_selection_condition     := ='X_ext < 1000d && Y_ext < 1000d' //panden met een grotere x/y range dan 1km eruit
																							'&& lower_x < 300000d && lower_x > 0d'
																							'&& upper_x < 300000d && upper_x > 0d'
																							'&& lower_y < 620000d && lower_y > 300000d'
																							'&& upper_y < 620000d && upper_y > 300000d' //; //binnen NL
																							'&& IsStudyArea';
				}
			}

			unit<UInt32> pand := select_with_attr_by_org_rel(src, src/Impl/pand_selection_condition);
		}
	}

	// de peildatum zit al in de snapshot, hier alleen nog de voorraadselectie
	attribute<Bool> pand_selection_condition (Snapshot/panden/pand) := Snapshot/panden/pand/IsVoorraad;
	unit<UInt32> pand := select_with_attr_by_cond(Snapshot/panden/pand, pand_selection_condition)
	, Descr = "set met panden op de peildatum (Parameters/BAG_Date) die voorraad zijn volgens de CBS definitie."
	{
		attribute<AHN/Tiles> Tile_rel := point_in_polygon(centroid_or_mid(geometry), AHN/Tiles/geometry);
	}
}
