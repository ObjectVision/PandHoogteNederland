container Templates : Using = "Units;Geography;Classifications"
{
	template define_grid_T
	{
		unit<ipoint> gridset;
		parameter<m> gridsizeX;
		parameter<m> gridsizeY;
		container bbox;
		// end case parameters

		parameter<int32> nr_cols := int32((bbox/x_max - bbox/x_min) / gridsizeX);
		parameter<int32> nr_rows := int32((bbox/y_max - bbox/y_min) / gridsizeY);

		 unit<ipoint> domain:=
			range(
					gridset
				   ,point_xy(bbox/x_min, bbox/y_max, rdc_meter)[gridset]
				   ,point_xy(bbox/x_min, bbox/y_max, rdc_meter)[gridset] 
				   + point_xy(nr_cols, nr_rows, gridset)
			  )
		,	DialogData = "rdc_meter"
		{
			attribute<uint8> test:= const(1b,.);
		}
	}
	
	template bepaal_hoogtes_en_daken_T
	{
		// begin case parameters
		unit<uint32> pand_subset;
		unit<ipoint> GridDomain;
		attribute<cm_int32> hoogte_ruw_offset (GridDomain); //dsm   /sourcedata/AHN/DSM/cell_1_6/heights/height
		attribute<cm_int32> hoogte_int_offset (GridDomain); //dtm
		// end case parameters

		attribute<pand_subset> pand_subset_rel (GridDomain) := poly2grid(pand_subset/geometry, GridDomain);

		container hoogte
		{
			container impl
			{
				container buffer_points
				{
					container max := bepaal_buffer_points_T(pand_subset, GridDomain, true);
					container min := bepaal_buffer_points_T(pand_subset, GridDomain, false);

					unit<uint32> all := union_unit(max/buffer_points, min/buffer_points)
					{
						attribute<rdc_meter>   geometry        := union_data(., max/buffer_points/geometry        , min/buffer_points/geometry);
						attribute<pand_subset> pand_subset_rel := union_data(., max/buffer_points/pand_subset_rel, min/buffer_points/pand_subset_rel);
						attribute<cm_int32>    hoogte_offset   := union_data(., max/buffer_points/hoogte_offset, min/buffer_points/hoogte_offset);
						attribute<string>      key             := string(pointCol(geometry)) + '_' + string(pointRow(geometry)) + '_' + string(pand_subset_rel);
					}

					unit<uint32> unique := unique(all/key)
					{
						attribute<all>         all_rel         := rlookup(values, all/key);
						attribute<rdc_meter>   geometry        := all/geometry[all_rel];
						attribute<pand_subset> pand_subset_rel := all/pand_subset_rel[all_rel];
						attribute<cm_int32>    hoogte_offset   := all/hoogte_offset[all_rel];
					}
				}
				// 20260622 terug naar percentiel: mean() gaf lage bias (randpixels tellen mee + pieken worden weggemiddeld,
				// waardoor het hoogste gebouw uit de top verdween). 0.7 = origineel; Erik had naar 0.6 verlaagd voor ahn5/6.
				// 0.6 vs 0.7 nog valideren tegen referentie (3D BAG / handmatig sample).
			 	attribute<cm_int32> pand_hoogte_offset     (pand_subset) := rth_element(hoogte_ruw_offset, 0.7f, pand_subset_rel);
				// attribute<cm_int32> pand_hoogte_offset     (pand_subset) := mean(hoogte_ruw_offset, pand_subset_rel); // EO-voorstel 20260616; onderschat structureel.
				attribute<cm_int32> pand_hoogte_offset_nok (pand_subset) := rth_element(hoogte_ruw_offset, 0.8f, pand_subset_rel); // 0.8 voor ahn5/6 (Erik), origineel 0.9
				attribute<cm_int32> pand_hoogte_offset_top (pand_subset) := rth_element(hoogte_ruw_offset, 0.99f, pand_subset_rel); // ruis-robuuste piek (~max) voor echte tophoogte van torens

				attribute<cm_int32> buffer_hoogte_offset   (pand_subset) := rth_element(buffer_points/unique/hoogte_offset, 0.15f, buffer_points/unique/pand_subset_rel);

				// onderkant-kwaliteit: dakpixels tellen t.o.v. het per-pand buffermaaiveld (DTM naast pand).
				// NIET DSM-DTM per cel: in AHN6-tegels (Zwolle/Arnhem/Groningen) bevat de DTM onder panden
				// het dak i.p.v. geinterpoleerd maaiveld, waardoor DSM-DTM daar ~0 was en ~50% onterecht afviel.
				attribute<cm_int32> pand_maaiveld_cel      (GridDomain)  := buffer_hoogte_offset[pand_subset_rel];
				attribute<uint32>   n_pixels               (pand_subset) := uint32(pcount(pand_subset_rel));
				attribute<uint32>   n_pixels_boven_mv      (pand_subset) := uint32(pcount(hoogte_ruw_offset > pand_maaiveld_cel + /Parameters/min_pandhoogte ? pand_subset_rel : (0 / 0)[pand_subset]));
			}

			// ruwe pandhoogte (voor drempel); verschil past ruim in int16, maar int32 houdt de keten consistent
			attribute<cm_int32> pand_raw (pand_subset) :=
				(isDefined(impl/pand_hoogte_offset) && isDefined(impl/buffer_hoogte_offset) && (impl/pand_hoogte_offset > impl/buffer_hoogte_offset))
					? sub_or_null(impl/pand_hoogte_offset, impl/buffer_hoogte_offset)
					: (0 / 0)[cm_int32];

			// betrouwbaar = binnen fysieke grenzen EN genoeg dakpixels boven maaiveld
			// te laag/geen object => nieuw/gesloopt pand of geen AHN-dekking; te hoog (>250m) => DSM-artefact
			attribute<bool> betrouwbaar (pand_subset) :=
				isDefined(pand_raw)
				&& pand_raw >= /Parameters/min_pandhoogte
				&& pand_raw <= /Parameters/max_pandhoogte
				&& impl/n_pixels_boven_mv >= /Parameters/min_pixels_boven_mv;

			attribute<cm_int32> pand (pand_subset) := betrouwbaar ? pand_raw : (0 / 0)[cm_int32];

			attribute<cm_int32> nok  (pand_subset) :=
				(isDefined(impl/pand_hoogte_offset_nok) && isDefined(impl/buffer_hoogte_offset) && (impl/pand_hoogte_offset_nok > impl/buffer_hoogte_offset))
					? sub_or_null(impl/pand_hoogte_offset_nok, impl/buffer_hoogte_offset)
					: (0 / 0)[cm_int32];

			attribute<cm_int32> top  (pand_subset) :=
				(isDefined(impl/pand_hoogte_offset_top) && isDefined(impl/buffer_hoogte_offset) && (impl/pand_hoogte_offset_top > impl/buffer_hoogte_offset))
					? sub_or_null(impl/pand_hoogte_offset_top, impl/buffer_hoogte_offset)
					: (0 / 0)[cm_int32];
		}

		// inhoud en dakanalyse overgenomen uit TDAAnalytics_pandkenmerken_kwartaalupdate (stam/schemas/bag_blad/bepaal_hoogtes_en_daken.dms);
		// verschil: de correctie bij te weinig AHN-waarnemingen gebruikt de PHN-pandhoogte (rth 0.7, alleen als betrouwbaar)
		container inhoud
		{
			container referentie
			{
				attribute<m2>     pand_oppervlakte                     (pand_subset) := area(pand_subset/geometry, m2);
				attribute<uint32> verwachte_ahn_waarnemingen           (pand_subset) := value(pand_oppervlakte / 0.25[m2], uint32);
				attribute<uint32> ahn_waarnemingen_na_interpolatie     (pand_subset) := count(potential/hoogte_ahn_met_interpolatie, pand_subset_rel);
				attribute<int32>  missende_observaties_na_interpolatie (pand_subset) := verwachte_ahn_waarnemingen[int32] - ahn_waarnemingen_na_interpolatie[int32];

				container teveel_ahn_waarnemingen
				{
					attribute<bool> heeft_teveel   (pand_subset) := missende_observaties_na_interpolatie < 0i;
					attribute<m3>   pand_inhoud_m3 (pand_subset) := heeft_teveel
						? (float64(verwachte_ahn_waarnemingen) / float64(ahn_waarnemingen_na_interpolatie)) * basic/pand_inhoud_m3
						: (0 / 0)[m3];
				}
				container teweinig_ahn_waarnemingen
				{
					attribute<bool> heeft_teweinig (pand_subset) := missende_observaties_na_interpolatie > 0i;
					attribute<m3>   pand_inhoud_m3 (pand_subset) := heeft_teweinig
						? basic/pand_inhoud_m3 + (float64(missende_observaties_na_interpolatie) * (hoogte/pand[cm] * 50[cm] * 50[cm])[m3])
						: (0 / 0)[m3];
				}
				container evenveel_ahn_waarnemingen
				{
					attribute<bool> heeft_evenveel (pand_subset) := missende_observaties_na_interpolatie == 0i;
					attribute<m3>   pand_inhoud_m3 (pand_subset) := heeft_evenveel ? basic/pand_inhoud_m3 : (0 / 0)[m3];
				}

				attribute<m3>    pand_inhoud_m3                     (pand_subset) :=
					MakeDefined(evenveel_ahn_waarnemingen/pand_inhoud_m3, MakeDefined(teveel_ahn_waarnemingen/pand_inhoud_m3, teweinig_ahn_waarnemingen/pand_inhoud_m3));
				attribute<ratio> ratio_ahn_waarn_tov_verwacht_waarn (pand_subset) := float64(ahn_waarnemingen_na_interpolatie) / float64(verwachte_ahn_waarnemingen);
			}

			// float32 (cm, incl. offset) omdat de kernel float32 is; gaten (null of 0) in de DSM gevuld met het gewogen gemiddelde van de buren
			container potential
			{
				attribute<float32> hoogte_ruw                  (GridDomain) := float32(hoogte_ruw_offset);
				attribute<float32> hoogte_interpolatie         (GridDomain) :=
					  potential(hoogte_ruw                       , Geography/kernel_buffer/distMatr)
					/ potential(hoogte_ruw > 0f ? 1f : 0f        , Geography/kernel_buffer/distMatr);
				attribute<float32> hoogte_ahn_met_interpolatie (GridDomain) := (isNull(hoogte_ruw) || hoogte_ruw == 0f) ? hoogte_interpolatie : hoogte_ruw;
			}

			container basic
			{
				attribute<float32> buffer_hoogte_grid (GridDomain)  := float32(hoogte/impl/buffer_hoogte_offset[pand_subset_rel]);
				attribute<cm3>     pand_inhoud_cm3    (pand_subset) := value(float64(sum(potential/hoogte_ahn_met_interpolatie - buffer_hoogte_grid, pand_subset_rel)), cm) * 50[cm] * 50[cm];
				attribute<m3>      pand_inhoud_m3     (pand_subset) := pand_inhoud_cm3[m3];
			}
		}

		container dak
		{
			attribute<cm>         hoogtes_in_pand (GridDomain) := isDefined(pand_subset_rel) ? hoogte_ruw_offset[cm] - 10000[cm] : (0 / 0)[cm];
			attribute<GridDomain> idGrid          (GridDomain) := id(GridDomain);
			attribute<cm_int32>   pand_buffer_hoogte_offset (pand_subset) := hoogte/impl/buffer_hoogte_offset; // alias: in pand_dakvlak verwijst 'hoogte' naar het eigen attribuut

			container gradient
			{
				attribute<cm>         N             (GridDomain) := hoogtes_in_pand[(idGrid) - point_xy(0i, 1i, ipoint)] - hoogtes_in_pand[(idGrid)];
				attribute<cm>         Z             (GridDomain) := hoogtes_in_pand[(idGrid) + point_xy(0i, 1i, ipoint)] - hoogtes_in_pand[(idGrid)];
				attribute<cm>         O             (GridDomain) := hoogtes_in_pand[(idGrid) - point_xy(1i, 0i, ipoint)] - hoogtes_in_pand[(idGrid)];
				attribute<cm>         W             (GridDomain) := hoogtes_in_pand[(idGrid) + point_xy(1i, 0i, ipoint)] - hoogtes_in_pand[(idGrid)];

				attribute<cm>         X             (GridDomain) := hoogtes_in_pand[(idGrid) - point_xy(1i, 0i, ipoint)] - hoogtes_in_pand[(idGrid) + point_xy(1i, 0i, ipoint)];
				attribute<cm>         Y             (GridDomain) := hoogtes_in_pand[(idGrid) + point_xy(0i, 1i, ipoint)] - hoogtes_in_pand[(idGrid) - point_xy(0i, 1i, ipoint)];

				attribute<cm>         amplitude     (GridDomain) := abs(N) + abs(Z) + abs(O) + abs(W);
				attribute<stijlheid>  stijlheid_rel (GridDomain) := classify(amplitude, stijlheid/ClassBreaks);

				parameter<float64>    rc := 1.0 + sqrt(2.0);

				attribute<windstreek> windstreek_rel (GridDomain) := switch(
					 case(amplitude <= 10[cm] , 8[windstreek])
					,case( (Y >= (rc * abs(X))), 0[windstreek])
					,case( (Y <  (rc * X)) && X <= (rc * Y), 1[windstreek])
					,case( (X >= (rc * abs(Y))), 2[windstreek])
					,case((-Y <  (rc * X)) && X <= (rc * -Y), 3[windstreek])
					,case((-Y >= (rc * abs(X))), 4[windstreek])
					,case((-Y <  (rc * -X)) && -X <= (rc *  -Y), 5[windstreek])
					,case((-X >= (rc * abs(Y))), 6[windstreek])
					,case(( Y <  (rc * -X)) && -X <= (rc *  Y), 7[windstreek])
					,9[windstreek]
				);

				attribute<daktype>    daktype_rel   (GridDomain) := Classify(windstreek_rel * 10b + stijlheid_rel, daktype/key);
			}

			// perc_vlak: aandeel dakcellen met stijlheid 'vlak'
			attribute<uint32> nr_cellen_vlak          (pand_subset) := sum(gradient/stijlheid_rel == stijlheid/V/vlak ? 1 : 0, pand_subset_rel);
			attribute<uint32> nr_cellen_met_stijlheid (pand_subset) := sum(isDefined(gradient/stijlheid_rel)     ? 1 : 0, pand_subset_rel);
			attribute<uint8>  perc_vlak               (pand_subset) := uint8(round((100f * float32(nr_cellen_vlak)) / (float32(nr_cellen_met_stijlheid))));

			container kromming
			{
				attribute<cm>   X               (GridDomain) := hoogtes_in_pand[(idGrid) + point_xy( 1i, 0i,ipoint)] + hoogtes_in_pand[(idGrid) - point_xy( 1i, 0i,ipoint)] - 2.0 * hoogtes_in_pand;
				attribute<cm>   Y               (GridDomain) := hoogtes_in_pand[(idGrid) + point_xy( 0i, 1i,ipoint)] + hoogtes_in_pand[(idGrid) - point_xy( 0i, 1i,ipoint)] - 2.0 * hoogtes_in_pand;
				attribute<bool> isOnderdeelVlak (GridDomain) := abs(kromming/X) <= 30[cm] && abs(kromming/Y) <= 30[cm];
			}

			container vlakken
			{
				attribute<daktype> daktype_rel_vlak (GridDomain) := kromming/isOnderdeelVlak ? gradient/daktype_rel : (0 / 0)[daktype];
				unit<uint32> districts := district(daktype_rel_vlak)
				{
					attribute<uint64> unieke_districts_rel (GridDomain) := rlookup(districts, unieke_districts/values);
				}
				unit<uint64> unieke_districts := unique(districts/districts)
				{
					attribute<uint64> nr_cellen := pcount(districts/unieke_districts_rel);
				}
				unit<uint32> plus_1m2 := select_uint32_with_attr_by_org_rel(unieke_districts, unieke_districts/nr_cellen > 4uint64);
				attribute<plus_1m2>   plus_1m2_rel   (GridDomain) := rlookup(districts/districts, plus_1m2/values);
				attribute<stijlheid>  stijlheid_rel  (GridDomain) := isDefined(plus_1m2_rel) ? gradient/stijlheid_rel  : (0 / 0)[stijlheid];
				attribute<windstreek> windstreek_rel (GridDomain) := isDefined(plus_1m2_rel) ? gradient/windstreek_rel : (0 / 0)[windstreek];

				unit<uint32> plus_1m2_rel_points := select_uint32_with_attr_by_org_rel(vlakken, isDefined(plus_1m2_rel))
				{
					attribute<pand_subset>  pand_subset_rel_vlak := pand_subset_rel[org_rel];
					attribute<string>       pand_dakvlak_key     := string(pand_subset_rel_vlak) + '_' + string(plus_1m2_rel);
					attribute<pand_dakvlak> pand_dakvlak_rel     := rlookup(pand_dakvlak_key, pand_dakvlak/values);

					attribute<cm_int32>     hoogte_offset        := hoogte_ruw_offset[org_rel];
					attribute<cm>           amplitude            := gradient/amplitude[org_rel];

					attribute<cm>           dX                   := gradient/X[org_rel];
					attribute<cm>           dY                   := gradient/Y[org_rel];

					attribute<rdc_meter>    geometry             := org_rel[rdc_meter];
					attribute<m>            X                    := pointCol(geometry)[m];
					attribute<m>            Y                    := pointRow(geometry)[m];
				}

				unit<uint32> pand_dakvlak := unique(plus_1m2_rel_points/pand_dakvlak_key)
				,	DialogType = "Map"
				,	DialogData = "geometry"
				{
					attribute<rdc_meter> geometry (poly) := points2sequence(geom/pointset/point, geom/pointset/sequence, geom/pointset/ordinal);
					container geom
					{
						attribute<m> minX (pand_dakvlak) := min(plus_1m2_rel_points/X, plus_1m2_rel_points/pand_dakvlak_rel);
						attribute<m> minY (pand_dakvlak) := min(plus_1m2_rel_points/Y, plus_1m2_rel_points/pand_dakvlak_rel);
						attribute<m> maxX (pand_dakvlak) := max(plus_1m2_rel_points/X, plus_1m2_rel_points/pand_dakvlak_rel);
						attribute<m> maxY (pand_dakvlak) := max(plus_1m2_rel_points/Y, plus_1m2_rel_points/pand_dakvlak_rel);

						unit<uint32> pointset := union_unit(pand_dakvlak, pand_dakvlak, pand_dakvlak, pand_dakvlak, pand_dakvlak)
						{
							attribute<rdc_meter>    point    := union_data(., point_xy(minX,maxY,rdc_meter), point_xy(maxX,maxY,rdc_meter), point_xy(maxX,minY,rdc_meter), point_xy(minX,minY,rdc_meter), point_xy(minX,maxY,rdc_meter));
							attribute<pand_dakvlak> sequence := union_data(., id(pand_dakvlak), id(pand_dakvlak), id(pand_dakvlak), id(pand_dakvlak), id(pand_dakvlak));
							attribute<uint32>       ordinal  := union_data(., const(0,pand_dakvlak), const(1,pand_dakvlak), const(2,pand_dakvlak), const(3,pand_dakvlak), const(4,pand_dakvlak));
						}
					}

					attribute<pand_subset> pand_subset_rel      := rjoin(values, plus_1m2_rel_points/pand_dakvlak_key, plus_1m2_rel_points/pand_subset_rel_vlak);
					attribute<uint64>      pand_identificatie   := pand_subset/pand_bag_nr[pand_subset_rel];

					attribute<uint32>      nr_m2                := pcount(plus_1m2_rel_points/pand_dakvlak_rel) / 4;
					attribute<cm>          amplitude            := mean(plus_1m2_rel_points/amplitude, plus_1m2_rel_points/pand_dakvlak_rel);
					attribute<stijlheid>   co_stijlheid         := classify(amplitude, stijlheid/ClassBreaks);
					attribute<windstreek>  windstreek_rel       := rjoin(values, plus_1m2_rel_points/pand_dakvlak_key, plus_1m2_rel_points/windstreek_rel);

					attribute<cm_int32>    hoogte_offset        := rth_element(plus_1m2_rel_points/hoogte_offset, 0.7f, plus_1m2_rel_points/pand_dakvlak_rel);
					attribute<cm_int32>    buffer_hoogte_offset := dak/pand_buffer_hoogte_offset[pand_subset_rel];

					attribute<cm_int32>    hoogte               :=
						(isDefined(hoogte_offset) && isDefined(buffer_hoogte_offset) && (hoogte_offset > buffer_hoogte_offset))
							? sub_or_null(hoogte_offset, buffer_hoogte_offset)
							: (0 / 0)[cm_int32];

					attribute<cm>          dX                   := mean(plus_1m2_rel_points/dX, plus_1m2_rel_points/pand_dakvlak_rel);
					attribute<cm>          dY                   := mean(plus_1m2_rel_points/dY, plus_1m2_rel_points/pand_dakvlak_rel);
				}
			}
		}
	}

	template bepaal_buffer_points_T
	{
		// begin template parameters
		unit<uint32>    pand_subset;
		unit<ipoint>    GridDomain;
		parameter<bool> isMax;
		// end template parameters

		// grid buffers gebruikt voor bepaling maaiveld hoogte
		attribute<float32>     proximity_arg   (GridDomain) := isMax ? (float32(pand_subset_rel) + 1f) : float32(#pand_subset) - (float32(pand_subset_rel)); // + 1 is nodig omdat anders de proximity naar pand 0 hetzelfde zou zijn als het buitengebied
		attribute<float32>     proximity_res   (GridDomain) := proximity(proximity_arg, Geography/kernel_buffer/distMatr);
		attribute<pand_subset> pand_met_buffer (GridDomain) := isMax 
			? (proximity_res - 1f)[pand_subset] 
			: (proximity_res = 0f 
				? (0 / 0)[pand_subset] 
				: (float32(#pand_subset) - proximity_res)[pand_subset]);

		attribute<pand_subset> buffer (GridDomain) := isDefined(pand_subset_rel) ? (0 / 0)[pand_subset] : pand_met_buffer;

		unit<uint64> buffer_points := select_with_org_rel(isDefined(buffer) && isDefined(hoogte_int_offset) && hoogte_int_offset > 0[cm_int32])
		{
			attribute<rdc_meter> geometry      := org_rel[rdc_meter];
			attribute<pand_subset> pand_subset_rel := buffer[org_rel];
			attribute<cm_int32>  hoogte_offset := hoogte_int_offset[org_rel];
		}
	}
}